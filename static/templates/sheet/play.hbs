<section class="tab hc-panel {{tab.cssClass}}" data-tab="play" data-group="primary">
  <div class="strip"><span>BAB <b>{{bab}}</b></span><span>Size <b>{{sizeLabel}}</b></span></div>
  <div class="play-grid">
    <div>
      <div class="section-head"><h3>Skills</h3><span class="trained-count{{#if trained.over}} over{{/if}}">Trained <b class="total" data-tooltip-html="{{trained.tooltip}}">{{trained.marked}} / {{trained.allowed}}</b></span></div>
      <div class="skill-list">
        {{#each skills}}
        <div class="skill" data-skill="{{key}}">
          {{#if @root.editMode}}
          <button type="button" class="dot{{#if marked}} on{{/if}}" data-action="toggleTrained" data-skill="{{key}}" aria-pressed="{{#if marked}}true{{else}}false{{/if}}" aria-label="Trained: {{label}}"></button>
          {{else}}
          <span class="dot{{#if trained}} on{{/if}}" {{#if trained}}aria-label="Trained"{{/if}}></span>
          {{/if}}
          <span>{{label}}</span><span class="num total" data-tooltip-html="{{tooltip}}">{{total}}</span>
          <button type="button" class="roll-btn" data-action="rollSkill" data-skill="{{key}}" aria-label="Roll {{label}}"><i class="fa-solid fa-dice-d20" inert></i></button>
        </div>
        {{/each}}
      </div>
    </div>
    <div>
      <div class="section-head"><h3>Attacks</h3></div>
      <div class="list">
        {{#each attacks}}
        <div class="list-row" data-item-id="{{id}}">
          <div class="main"><span class="nm">{{name}}</span>{{#if type}}<span class="tag {{typeClass}}">{{type}}</span>{{/if}}
            <span class="meta"><b data-tooltip-html="{{attackTooltip}}">{{attack}}</b> · <b>{{damage}}</b></span></div>
          <div class="end"><button type="button" class="btn primary" data-action="attack" data-item-id="{{id}}">Attack</button><button type="button" class="btn" data-action="damage" data-item-id="{{id}}">Damage</button></div>
        </div>
        {{else}}
        <div class="empty-note">No weapons.</div>
        {{/each}}
      </div>
      <div class="section-head talents-head"><h3>Talents</h3></div>
      <div class="list" data-list="talents">
        {{#each talents}}
        <div class="list-row" data-item-id="{{id}}">
          <div class="main"><span class="nm">{{name}}</span>{{#if action}}<span class="cost-tag">{{action}}</span>{{/if}}<span class="meta">{{tree}}</span></div>
          <div class="end">{{#if @root.editMode}}<button type="button" class="btn remove" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash" inert></i></button>{{/if}}</div>
        </div>
        {{else}}
        <div class="empty-note">No talents. Drag one from the Talents compendium.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>
