<section class="tab hc-panel {{tab.cssClass}}" data-tab="build" data-group="primary">
  {{#if problems.length}}
  <ul class="hc-problems">{{#each problems}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}
  <div class="cols">
    <div class="card" data-card="abilities">
      <div class="section-head"><h3>Ability scores</h3>
        {{#if abilityBuy}}<span class="hint pb-count{{#if pointBuy.over}} over{{/if}}">Point buy {{pointBuy.spent}} / {{pointBuy.budget}}</span>{{else}}<span class="hint">Scores entered by hand</span>{{/if}}</div>
      {{#if abilityBuy}}<div class="meter" aria-hidden="true"><i style="width: {{pointBuy.percent}}%"></i></div>{{/if}}
      {{#if editMode}}
      <div class="minseg" role="group" aria-label="How scores are set">
        <button type="button" data-action="abilityEntry" data-mode="buy" aria-pressed="{{#if abilityBuy}}true{{else}}false{{/if}}">Point buy</button>
        <button type="button" data-action="abilityEntry" data-mode="enter" aria-pressed="{{#if abilityBuy}}false{{else}}true{{/if}}">Enter scores</button>
      </div>
      {{/if}}
      <table class="abil">
        <thead><tr><th>Ability</th><th>Bought</th><th>Species</th><th>Level-ups</th><th>Score</th><th>Mod</th></tr></thead>
        <tbody>
          {{#each abilities}}
          <tr data-ability="{{key}}">
            <td>{{label}}</td>
            <td>
              {{#if @root.editMode}}
                {{#if @root.abilityBuy}}
                <span class="stepper-cell"><button type="button" class="step" data-action="abilityStep" data-ability="{{key}}" data-delta="-1" aria-label="Lower {{label}}" {{#unless canLower}}disabled{{/unless}}>-</button><b class="bought">{{base}}</b><button type="button" class="step" data-action="abilityStep" data-ability="{{key}}" data-delta="1" aria-label="Raise {{label}}" data-tooltip="{{nextCostHint}}" {{#unless canRaise}}disabled{{/unless}}>+</button></span>
                {{else}}
                <input class="ab-input" type="number" name="system.abilities.{{key}}.base" value="{{base}}" min="1" max="30" aria-label="{{label}} score">
                {{/if}}
              {{else}}<span class="bought">{{base}}</span>{{/if}}
            </td>
            <td>
              {{#if @root.editMode}}
              {{#if fixed}}<span>{{fixed}}</span> {{/if}}<button type="button" class="sp-pick{{#if chosen}} on{{/if}}" data-action="speciesPick" data-ability="{{key}}" aria-pressed="{{#if chosen}}true{{else}}false{{/if}}"
                {{#unless pickAllowed}}disabled data-tooltip="A Small species may not put its +2 any on DEX"{{/unless}}>+2</button>
              {{else}}{{speciesShown}}{{/if}}
            </td>
            <td>{{levelUps}}</td>
            <td class="score total" data-tooltip-html="{{tooltip}}">{{value}}</td>
            <td>{{mod}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{#if speciesUnplaced}}<div class="hint"><b>Place the species' +2 any{{#unless editMode}} in Edit mode{{/unless}}.</b></div>{{/if}}
    </div>

    <div class="card" data-card="defense-points">
      <div class="section-head"><h3>Defense points</h3><span class="hint">{{defensePoints.spent}} / {{defensePoints.total}} spent</span></div>
      <div class="defpts">
        {{#each defensePoints.rows}}
        <div class="defpt" data-defense-points="{{key}}">
          <div class="label">{{label}}</div>
          <div class="def-total num">{{total}}</div>
          <div class="def-pts">
            {{#if @root.editMode}}<button type="button" class="step" data-action="defenseStep" data-defense="{{key}}" data-delta="-1" aria-label="Take a point from {{label}}" {{#unless canLower}}disabled{{/unless}}>-</button>{{/if}}
            <span class="pts">{{points}}</span>
            {{#if @root.editMode}}<button type="button" class="step" data-action="defenseStep" data-defense="{{key}}" data-delta="1" aria-label="Add a point to {{label}}" {{#unless canRaise}}disabled{{/unless}}>+</button>{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      <div class="hint">Max {{defensePoints.each}} in one Defense. At level 10: 8 points, max 4.</div>
    </div>

    <div class="card" data-card="identity">
      <div class="section-head"><h3>Identity</h3></div>
      <div class="row"><span>Species</span><span>{{speciesName}}{{#if editMode}} <button type="button" class="btn" data-action="browse" data-target="species">Change</button>{{/if}}</span></div>
      <div class="row"><span>Classes</span><span>{{#if classLine}}{{classLine}}{{else}}None{{/if}}</span></div>
      <div class="row"><span>Trained skills</span><span class="num{{#if trained.over}} over{{/if}}"><span class="total" data-tooltip-html="{{trained.tooltip}}">{{trained.marked}} / {{trained.allowed}}</span></span></div>
    </div>

    <div class="card" data-card="languages">
      <div class="section-head"><h3>Languages</h3></div>
      <div class="row"><span>Also speaks</span>
        {{#if editMode}}
        <select name="system.languages.alsoSpeaks" aria-label="Also speaks">
          <option value="" {{#unless languages.alsoSpeaks}}selected{{/unless}}>None</option>
          {{#each languages.speakOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
        </select>
        {{else}}<span>{{#if languages.alsoSpeaks}}{{languages.alsoSpeaks}}{{else}}None{{/if}}</span>{{/if}}
      </div>
      <div class="row" data-resource="understands"><span>Understands</span><span class="total" data-tooltip-html="{{understands.tooltip}}">{{understands.shown}}</span></div>
      <label class="label">Other languages
        <input type="text" name="system.languages.other" value="{{languages.other}}" placeholder="As the GM decides" {{#unless editMode}}disabled{{/unless}}>
      </label>
      <div class="hint">May speak: {{languages.speaks}}. INT 12 understands Commons, 16 Commons and Rares, 20 Commons, Rares and Secrets.</div>
    </div>
  </div>

  <div class="card" data-card="trees">
    <div class="section-head"><h3>Talent tree access</h3><span class="hint">{{treeAccess.total}} trees</span></div>
    {{#if treeAccess.jedi}}
    <div class="tradition-row">
      <span class="label">Tradition (Jedi class)</span>
      {{#if editMode}}
      <select name="system.talentAccess.tradition" aria-label="Tradition">{{#each treeAccess.traditions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      {{#if treeAccess.picks}}<select name="system.talentAccess.traditionTree" aria-label="Tradition tree"><option value="" {{#unless treeAccess.pickChosen}}selected{{/unless}}>Choose a tree</option>{{#each treeAccess.picks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select>{{/if}}
      {{else}}<span>{{treeAccess.traditionLabel}}</span>{{/if}}
      {{#if treeAccess.species}}<span class="hint">{{treeAccess.species}} only</span>{{/if}}
    </div>
    {{/if}}
    <div class="tree-groups">
      {{#each treeAccess.groups}}
      <div class="tree-group" data-group="{{label}}"><span class="label">{{label}}</span>
        <div class="chips">{{#each trees}}<span class="chip{{#if removed}} removed{{/if}}" data-tree="{{name}}">{{name}}{{#if @root.editMode}}<button type="button" data-action="toggleTree" data-tree="{{name}}" aria-label="{{#if removed}}Restore{{else}}Remove{{/if}} {{name}}">{{#if removed}}&#8634;{{else}}&#10005;{{/if}}</button>{{/if}}</span>{{else}}<span class="hint">Pick the tradition tree above</span>{{/each}}</div>
      </div>
      {{/each}}
      <div class="tree-group" data-group="Added by hand"><span class="label">Added by hand</span>
        <div class="chips">{{#each treeAccess.added}}<span class="chip hand" data-tree="{{this}}">{{this}}{{#if @root.editMode}}<button type="button" data-action="unaddTree" data-tree="{{this}}" aria-label="Remove {{this}}">&#10005;</button>{{/if}}</span>{{else}}<span class="hint">None</span>{{/each}}</div>
      </div>
      <div class="tree-group"><span class="label">Banned</span><div class="hint">{{treeAccess.banned}}</div></div>
    </div>
    {{#if editMode}}
    <div class="add-tree-row">
      <select class="add-tree" aria-label="Tree to add">{{#each treeAccess.addable}}<option value="{{this}}">{{this}}</option>{{/each}}</select>
      <button type="button" class="btn primary" data-action="addTree">Add tree</button>
    </div>
    {{else}}
    <div class="hint">Unlock the sheet to add or remove trees by hand. The browser's "Only trees my classes grant" uses this list.</div>
    {{/if}}
  </div>

  <div class="card" data-card="feats">
    <div class="section-head"><h3>Feats</h3></div>
    <div class="list" data-list="feats">
      {{#each feats}}
      <div class="list-row" data-item-id="{{id}}">
        <div class="main"><span class="nm">{{name}}</span></div>
        <div class="end">{{#if @root.editMode}}<button type="button" class="btn remove" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash" inert></i></button>{{/if}}</div>
      </div>
      {{else}}
      <div class="empty-note">No feats. Drag one from the Feats compendium.</div>
      {{/each}}
    </div>
  </div>

  <div class="card" data-card="progression">
    <div class="section-head"><h3>Progression</h3>
      {{#if editMode}}{{#unless levelUp}}<button type="button" class="btn primary" data-action="levelUpStart">Level up</button>{{/unless}}{{/if}}</div>
    {{#each progression}}
    <div class="level-row" data-level="{{level}}">
      <div class="lvl">Level {{level}}<small>{{className}} {{classLevel}}</small></div>
      <div class="slots">
        <span class="slot"><span class="kind">Hit points</span><span class="hp-result">{{hitPoints}}</span></span>
        {{#if increases}}<span class="slot"><span class="kind">Abilities</span>+1 {{increases}}</span>{{/if}}
        {{#if increaseDue}}
          {{#if @root.editMode}}
          <span class="slot increase-picker"><span class="kind">Abilities</span>+1 and +1:
            {{#each increaseOptions}}<button type="button" class="sp-pick{{#if picked}} on{{/if}}" data-action="increasePick" data-level="{{../level}}" data-ability="{{key}}" aria-pressed="{{#if picked}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
            <button type="button" class="btn primary" data-action="increaseSave" data-level="{{level}}" {{#unless increaseReady}}disabled{{/unless}}>Save</button></span>
          {{else}}
          <span class="slot empty"><span class="kind">Abilities</span>+1 and +1 to choose in Edit mode</span>
          {{/if}}
        {{/if}}
        {{#each slots}}
          {{#if filled}}<span class="slot{{#if granted}} granted{{/if}}" data-slot-kind="{{kind}}"><span class="kind">{{label}}</span>{{filled.name}}{{#if filled.tree}} <span class="tree">{{filled.tree}}</span>{{/if}}</span>
          {{else if canFill}}<button type="button" class="slot empty" data-action="fillSlot" data-level="{{level}}" data-kind="{{kind}}" data-class="{{cls}}"><span class="kind">{{label}}</span>Choose</button>
          {{else}}<span class="slot empty" data-slot-kind="{{kind}}"><span class="kind">{{label}}</span>Choose in Edit mode</span>{{/if}}
        {{/each}}
        {{#if @root.editMode}}{{#if isLast}}<button type="button" class="btn remove-level" data-action="removeLevel">Remove level {{level}}</button>{{/if}}{{/if}}
      </div>
    </div>
    {{else}}
    <div class="empty-note">No levels yet.{{#unless editMode}} Unlock the sheet to take level 1.{{/unless}}</div>
    {{/each}}

    {{#if levelUp}}
    <div class="level-row levelup-row" data-level-up="{{levelUp.step}}">
      <div class="lvl">Level {{levelUp.level}}<small>{{#if (eq levelUp.step "hp")}}{{levelUp.name}}{{else}}Choose a class{{/if}}</small></div>
      <div class="slots">
        {{#if (eq levelUp.step "class")}}
          {{#each levelUp.taken}}<button type="button" class="btn" data-action="levelClass" data-class-id="{{id}}">{{name}} {{nextLevel}}</button>{{/each}}
          {{#if levelUp.packMissing}}<span class="hint">The Classes compendium is not loaded.</span>{{else}}
          <select class="level-class" aria-label="Another class">
            <option value="">Another class...</option>
            <optgroup label="Base">{{#each levelUp.base}}<option value="{{uuid}}" data-die="{{die}}">{{name}}</option>{{/each}}</optgroup>
            <optgroup label="Prestige">{{#each levelUp.prestige}}<option value="{{uuid}}" data-die="{{die}}">{{name}}</option>{{/each}}</optgroup>
          </select>{{/if}}
        {{else}}
          <span class="hint">Hit points:</span>
          <button type="button" class="btn primary" data-action="levelHp" data-mode="average">Take {{levelUp.average}}</button>
          <button type="button" class="btn" data-action="levelHp" data-mode="roll">Roll 1d{{levelUp.die}}</button>
          <span class="hint">CON {{levelUp.conMod}} is added per level.</span>
        {{/if}}
        <button type="button" class="btn" data-action="levelUpCancel">Cancel</button>
      </div>
    </div>
    {{/if}}
  </div>
</section>
